[0.084082, "o", "\u001b[?2004h\u001b]0;alext@b450: /mnt/c/Projects/dz2-db_Tyrko_M26-555\u0007\u001b[01;32malext@b450\u001b[00m:\u001b[01;34m/mnt/c/Projects/dz2-db_Tyrko_M26-555\u001b[00m$ "]
[1.484114, "o", "\u001b[7muv run database\u001b[27m"]
[2.294614, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\buv run database\r\n\u001b[?2004l\r"]
[2.388089, "o", "\r\nПервая попытка запустить проект!\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n"]
[2.389831, "o", "Введите команду: "]
[5.337129, "o", "create_table users name:str age:int is_active:bo"]
[5.337461, "o", "ol"]
[5.831396, "o", "\r\n\r\n"]
[5.833418, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[5.835138, "o", "Введите команду: "]
[9.15749, "o", "list_tables"]
[9.65915, "o", "\r\n"]
[9.659423, "o", "\r\n- users\r\n"]
[9.661052, "o", "Введите команду: "]
[13.161881, "o", "drop_table users"]
[13.754839, "o", "\r\n\r\n"]
[13.756773, "o", "Таблица \"users\" успешно удалена\r\n"]
[13.7584, "o", "Введите команду: "]
[19.038424, "o", "list_tables"]
[19.556567, "o", "\r\n\r\n"]
[19.556837, "o", "Таблиц пока нет\r\n"]
[19.558476, "o", "Введите команду: "]
[22.718797, "o", "exit"]
[23.270771, "o", "\r\n\r\n"]
[23.270999, "o", "Выход из программы\r\n"]
[23.276658, "o", "\u001b[?2004h\u001b]0;alext@b450: /mnt/c/Projects/dz2-db_Tyrko_M26-555\u0007\u001b[01;32malext@b450\u001b[00m:\u001b[01;34m/mnt/c/Projects/dz2-db_Tyrko_M26-555\u001b[00m$ "]
[25.443965, "o", "\u001b[7mexit\u001b[27m"]
[25.962447, "o", "\b\b\b\bexit\r\n\u001b[?2004l\r"]
[25.962707, "o", "exit\r\n"]
