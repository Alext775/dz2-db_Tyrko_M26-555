[0.03021, "o", "\u001b[?2004h\u001b]0;alext@b450: /mnt/c/Projects/dz2-db_Tyrko_M26-555\u0007\u001b[01;32malext@b450\u001b[00m:\u001b[01;34m/mnt/c/Projects/dz2-db_Tyrko_M26-555\u001b[00m$ "]
[5.571862, "o", "\u001b[7muv run database\u001b[27m"]
[6.66601, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\buv run database\r\n\u001b[?2004l\r"]
[6.925936, "o", "\r\nПервая попытка запустить проект!\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n"]
[6.927916, "o", "Введите команду: "]
[11.767242, "o", "create_table users name:str age:int is_active:bool"]
[13.57255, "o", "\r\n\r\n"]
[13.574701, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[13.576231, "o", "Введите команду: "]
[19.133003, "o", "list_tables"]
